{
  "scripts": {
    "cy:open": "cypress open --e2e --browser chrome",
    "clean:reports": "if exist cypress\\reports rmdir /s /q cypress\\reports",
    "cy:chrome": "cypress run --headed --browser chrome --reporter mochawesome --reporter-options reportDir=cypress/reports/mocha,reportFilename=mochawesome,html=false,json=true,overwrite=false",
    "cy:merge": "mochawesome-merge \"cypress/reports/mocha/mochawesome*.json\" > cypress/reports/merged-report.json",
    "cy:html": "marge cypress/reports/merged-report.json --reportDir cypress/reports/html --reportFilename final-report",
    "test:report": "npm run clean:reports && npm run cy:chrome && npm run cy:merge && npm run cy:html"
  },
  "devDependencies": {
    "cypress": "^15.16.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  }
}
